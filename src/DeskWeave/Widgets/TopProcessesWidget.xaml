<UserControl x:Class="DeskWeave.Widgets.TopProcessesWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="340">
    <Border Style="{StaticResource WidgetPanel}">
        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Heading}" Text="TOP PROCESSES" />
                <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="TOP 3" FontSize="10" />
            </Grid>
            <ItemsControl x:Name="ProcessSections">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="3" Height="10" CornerRadius="1" Background="{Binding Tint}"
                                        Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="{Binding Label}"
                                           Foreground="{Binding Tint}" FontWeight="Bold" />
                                <TextBlock Grid.Column="2" Style="{StaticResource Label}" Text="{Binding Detail}"
                                           FontSize="9" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Label}" Text="{Binding Rank}" FontSize="9"
                                                       VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="0,0,8,0"
                                                       TextWrapping="Wrap" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Value}">
                                                        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                                                        <Setter Property="TextTrimming" Value="None" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Rank}" Value="01">
                                                                <Setter Property="Foreground" Value="{StaticResource BrightForegroundBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Rank}" Value="">
                                                                <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Style="{StaticResource Value}" Text="{Binding Value}"
                                                       Foreground="{Binding DataContext.Tint, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Top" />
                                            <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                         Style="{StaticResource Meter}" Height="2" Margin="0,3,0,0"
                                                         Value="{Binding RelativeUsage, Mode=OneWay}"
                                                         Foreground="{Binding DataContext.Tint, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                         Visibility="{Binding MeterVisibility}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Label}" FontSize="9" TextWrapping="Wrap"
                       Text="Bars compare processes within each resource." />
        </StackPanel>
    </Border>
</UserControl>
