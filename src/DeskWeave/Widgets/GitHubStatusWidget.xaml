<UserControl x:Class="DeskWeave.Widgets.GitHubStatusWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="340">
    <Border Style="{StaticResource WidgetPanel}">
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Heading}" Text="SERVICE STATUS" />
                <TextBlock x:Name="ProviderCount" Grid.Column="1" Style="{StaticResource Label}" />
            </Grid>

            <TextBlock x:Name="EmptyState"
                       Style="{StaticResource Label}"
                       Text="No providers selected"
                       Visibility="Collapsed" />

            <ItemsControl x:Name="Providers">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Value}"
                                           FontWeight="SemiBold"
                                           Text="{Binding Name}"
                                           Foreground="{Binding NameBrush}"
                                           HorizontalAlignment="Stretch"
                                           Margin="0,0,10,0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Style="{StaticResource Value}"
                                               Text="{Binding Status}"
                                               Foreground="{Binding StatusBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Label}"
                                       Text="{Binding Freshness}"
                                       Foreground="{Binding FreshnessBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource Label}"
                                       Text="{Binding Detail}"
                                       Foreground="{Binding DetailBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding DetailVisibility}"
                                       Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource Label}"
                                       Text="{Binding MoreIncidents}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding OtherIncidentOverflowVisibility}" />
                            <StackPanel Visibility="{Binding OtherMaintenanceVisibility}" Margin="0,5,0,0">
                                <TextBlock Style="{StaticResource Label}"
                                           Text="MAINTENANCE"
                                           Foreground="{Binding MaintenanceHeadingBrush}"
                                           Margin="0,0,0,2" />
                                <ItemsControl ItemsSource="{Binding Maintenance}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Value}"
                                                           Text="{Binding Name}"
                                                           Foreground="{Binding NameBrush}" />
                                                <TextBlock Style="{StaticResource Label}"
                                                           Text="{Binding Detail}"
                                                           Foreground="{Binding Brush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Label}"
                                           Text="{Binding MoreMaintenance}"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding MoreMaintenanceVisibility}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="ProviderOverflow"
                       Style="{StaticResource Label}"
                       Visibility="Collapsed"
                       Margin="0,0,0,5" />

            <StackPanel x:Name="GitHubDetails" Visibility="Collapsed">
                <Rectangle Height="1" Margin="0,2,0,10" Fill="{StaticResource DividerBrush}" />
                <StackPanel Visibility="{Binding ComponentsVisibility}">
                    <TextBlock Style="{StaticResource Label}"
                               Text="GITHUB COMPONENTS"
                               Foreground="{Binding ComponentsHeadingBrush}"
                               Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Components}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Value}"
                                               Text="{Binding Name}"
                                               Foreground="{Binding NameBrush}"
                                               HorizontalAlignment="Stretch"
                                               Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource Label}"
                                               Text="{Binding Label}"
                                               Foreground="{Binding Brush}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="100" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Label}"
                               Text="{Binding MoreComponents}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding MoreComponentsVisibility}" />
                </StackPanel>

                <StackPanel Visibility="{Binding IncidentsVisibility}" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Label}"
                               Text="ACTIVE INCIDENTS"
                               Foreground="{Binding IncidentsHeadingBrush}"
                               Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Incidents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding Brush}"
                                        BorderThickness="2,0,0,0"
                                        Padding="8,1,0,1"
                                        Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Value}"
                                                   Text="{Binding Name}"
                                                   Foreground="{Binding NameBrush}" />
                                        <TextBlock Style="{StaticResource Label}"
                                                   Text="{Binding Detail}"
                                                   Foreground="{Binding Brush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Label}"
                               Text="{Binding MoreIncidents}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding MoreIncidentsVisibility}" />
                </StackPanel>

                <StackPanel Visibility="{Binding MaintenanceVisibility}" Margin="0,8,0,0">
                    <TextBlock Style="{StaticResource Label}"
                               Text="MAINTENANCE"
                               Foreground="{Binding MaintenanceHeadingBrush}"
                               Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding Maintenance}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding Brush}"
                                        BorderThickness="2,0,0,0"
                                        Padding="8,1,0,1"
                                        Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Value}"
                                                   Text="{Binding Name}"
                                                   Foreground="{Binding NameBrush}" />
                                        <TextBlock Style="{StaticResource Label}"
                                                   Text="{Binding Detail}"
                                                   Foreground="{Binding Brush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Label}"
                               Text="{Binding MoreMaintenance}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding MoreMaintenanceVisibility}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
