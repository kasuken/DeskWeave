<UserControl x:Class="DeskWeave.Widgets.WorldClockWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <DataTemplate x:Key="ClockCell">
            <StackPanel Width="{Binding CellWidth, ElementName=Root}" Margin="0,3">
                <TextBlock Style="{StaticResource Label}" FontSize="10.5" Text="{Binding City}" TextTrimming="CharacterEllipsis" />
                <TextBlock FontFamily="{StaticResource MonoFont}">
                    <Run Text="{Binding TimeText, Mode=OneWay}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource BrightForegroundBrush}" />
                    <Run Text="{Binding DayDeltaText, Mode=OneWay}" FontSize="10" Foreground="{StaticResource MagentaBrush}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Label}" FontSize="9.5" Text="{Binding DateText}" />
                <TextBlock Style="{StaticResource Label}" FontSize="9.5" Foreground="{StaticResource DimBrush}" Text="{Binding UtcOffset}" />
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WingPanel">
            <UniformGrid Columns="{Binding WingColumns, ElementName=Root}" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource WidgetPanel}" Padding="14,10">
        <Grid x:Name="Layout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ItemsControl x:Name="LeftWing" ItemTemplate="{StaticResource ClockCell}" ItemsPanel="{StaticResource WingPanel}"
                          VerticalAlignment="Center" />

            <Border x:Name="Center" Grid.Column="1" Width="{Binding CenterWidth, ElementName=Root}" Margin="12,0"
                    Padding="0,4" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,1,0" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="LocalCity" Style="{StaticResource Heading}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LocalTime" FontFamily="{StaticResource MonoFont}" FontSize="34" FontWeight="SemiBold"
                               Foreground="{StaticResource BrightForegroundBrush}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LocalDetail" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="RightWing" Grid.Column="2" ItemTemplate="{StaticResource ClockCell}" ItemsPanel="{StaticResource WingPanel}"
                          VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
