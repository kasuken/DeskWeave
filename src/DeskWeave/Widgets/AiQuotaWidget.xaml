<UserControl x:Class="DeskWeave.Widgets.AiQuotaWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="340">
    <Border Style="{StaticResource WidgetPanel}">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Heading}" Text="AI SUBSCRIPTIONS" />
                <TextBlock x:Name="PlanCount" Grid.Column="1" Style="{StaticResource Label}" />
            </Grid>

            <ItemsControl x:Name="Providers">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Value}" FontWeight="SemiBold" Text="{Binding Name}" Foreground="{Binding Tint}" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="{Binding Plan}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Status}" Foreground="{StaticResource YellowBrush}"
                                       TextWrapping="Wrap" Visibility="{Binding StatusVisibility}" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Limits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Value}" Text="{Binding Label}" Margin="0,0,8,0" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Value}" Foreground="{Binding ValueBrush}" />
                                            </Grid>
                                            <ProgressBar Style="{StaticResource Meter}" Height="3" Margin="0,4,0,0"
                                                         Value="{Binding Used, Mode=OneWay}" Foreground="{Binding MeterBrush}"
                                                         Visibility="{Binding MeterVisibility}" />
                                            <TextBlock Style="{StaticResource Label}" Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                       Visibility="{Binding DetailVisibility}" />
                                            <TextBlock Style="{StaticResource Label}" Text="{Binding Forecast}" TextWrapping="Wrap"
                                                       Margin="0,3,0,0" Visibility="{Binding ForecastVisibility}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding OverflowSummary}"
                                       Visibility="{Binding OverflowVisibility}" />
                            <TextBlock Style="{StaticResource Label}" Text="{Binding LastKnown}" Visibility="{Binding LastKnownVisibility}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Rectangle Height="1" Margin="0,0,0,8" Fill="{StaticResource DividerBrush}" />
            <TextBlock x:Name="Footer" Style="{StaticResource Label}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
