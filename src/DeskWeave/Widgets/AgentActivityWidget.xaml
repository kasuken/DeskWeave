<UserControl x:Class="DeskWeave.Widgets.AgentActivityWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="340">
    <Border Style="{StaticResource WidgetPanel}">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Heading}" Text="AGENT ACTIVITY" />
                <TextBlock x:Name="Attention" Grid.Column="1" Style="{StaticResource Label}"
                           Foreground="{StaticResource YellowBrush}" />
            </Grid>
            <ItemsControl x:Name="Tasks">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Value}" Text="{Binding Workspace}"
                                           FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="{Binding State}"
                                           Foreground="{Binding Tint}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Detail}"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Timing}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="EmptyMessage" Style="{StaticResource Label}" Text="No recent tasks" Margin="0,0,0,8" />
            <TextBlock x:Name="Overflow" Style="{StaticResource Label}" Margin="0,0,0,8" />
            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,0,0,8" />
            <TextBlock x:Name="Summary" Style="{StaticResource Label}" Margin="0,0,0,5" />
            <ItemsControl x:Name="Sources">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,3">
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Status}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Label}" Text="{Binding Warning}"
                                       Foreground="{StaticResource YellowBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding WarningVisibility}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
